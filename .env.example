# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# .env is git-ignored — never commit real credentials.

# Generate a new one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me

# Must be False for anything other than local development.
DJANGO_DEBUG=True

# Comma-separated. Add the server's LAN IP so other branches can connect,
# e.g. localhost,127.0.0.1,192.168.1.50
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver

# Use a dedicated app user, not root. Create it once with:
#   CREATE USER 'gerlyn_app'@'localhost' IDENTIFIED BY 'your-password';
#   GRANT ALL PRIVILEGES ON `gerlyn_db`.*      TO 'gerlyn_app'@'localhost';
#   GRANT ALL PRIVILEGES ON `test_gerlyn_db`.* TO 'gerlyn_app'@'localhost';
DB_NAME=gerlyn_db
DB_USER=gerlyn_app
DB_PASSWORD=your-app-db-password
DB_HOST=localhost
DB_PORT=3306

# Origins allowed to call the API (the React dev server).
DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email delivery ---------------------------------------------------------
# Local development is safe by default: messages print in the runserver
# terminal and no external SMTP service is contacted.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# In production, change EMAIL_BACKEND to:
# django.core.mail.backends.smtp.EmailBackend
# Then configure the provider below. Gmail on port 587 uses TLS=True and
# SSL=False. Port 465 uses TLS=False and SSL=True. Never enable both.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# Gmail requires the full account address and an App Password (not the normal
# account password). Other providers may use different SMTP credentials.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Must be the authenticated address or an alias authorized by the provider.
# Leave blank to use EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=

# Required in production so links use the public HTTPS origin rather than an
# internal proxy hostname. No trailing slash. Leave blank locally to use the
# host and scheme of the current request.
PUBLIC_BASE_URL=

# --- Media storage (product images, GCash payment proofs) ------------------
# Leave these BLANK for local development: uploads stay on disk under
# MEDIA_ROOT and are served by the /media/ route. No account needed.
#
# In PRODUCTION, set all three (free account at https://cloudinary.com) and
# uploads go to Cloudinary's CDN instead — this survives redeploys on hosts
# with an ephemeral filesystem (Railway/Render). Find these three values on
# your Cloudinary dashboard. Setting CLOUDINARY_CLOUD_NAME is what switches
# storage over (see USE_CLOUDINARY in settings.py).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Cache backend -----------------------------------------------------------
# Leave BLANK to use DatabaseCache (the default — see CACHES in settings.py).
# Set this to move the cache to Redis instead (add Railway's Redis plugin,
# then paste its connection URL here / into the service's Variables tab).
REDIS_URL=

# --- Error tracking ----------------------------------------------------------
# Leave BLANK to disable (the default — see settings.py). Set this to a
# Sentry DSN (free tier at https://sentry.io) to get production error
# reports instead of only what's in Railway's log stream.
SENTRY_DSN=

# --- Address geocoding and map tiles ----------------------------------------
# Optional Nominatim-compatible endpoints. Leave blank to disable automatic
# lookup; users can still enter coordinates and move the pin manually.
GEOCODING_SEARCH_URL=
GEOCODING_REVERSE_URL=
GEOCODING_API_KEY=
GEOCODING_API_KEY_PARAM=key
GEOCODING_USER_AGENT=GerlynPLUS/1.0 (address picker; contact: admin@example.com)
GEOCODING_COUNTRY_CODE=ph
GEOCODING_TIMEOUT=6
GEOCODING_CACHE_SECONDS=86400
GEOCODING_NEGATIVE_CACHE_SECONDS=900
GEOCODING_CLIENT_MAX_REQUESTS=30
GEOCODING_CLIENT_WINDOW_SECONDS=60
GEOCODING_PROVIDER_MIN_INTERVAL_SECONDS=1

# Optional raster tile template. Supported placeholders: {z}, {x}, {y}, and
# {api_key}. Tiles are fetched and cached server-side, keeping the key private.
MAP_TILE_URL_TEMPLATE=
MAP_TILE_API_KEY=
MAP_TILE_ATTRIBUTION=
MAP_TILE_CACHE_SECONDS=604800
