# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# .env is git-ignored â€” never commit real credentials.

# Generate a new one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me

# LOCAL DEVELOPMENT ONLY. Leave this out (or False) on Railway/production --
# DEBUG pages print the full URL table, settings and tracebacks. settings.py
# ignores True on Railway as a safety net, but do not rely on it.
DJANGO_DEBUG=True

# Django admin (/admin/). On in local DEBUG automatically; OFF everywhere else
# unless you set this to True. Even when on, only genuine superusers get in.
# If you do enable it in production, also move it off the guessable path:
#   DJANGO_ADMIN_ENABLED=True
#   DJANGO_ADMIN_URL=some-long-random-path/
DJANGO_ADMIN_ENABLED=
DJANGO_ADMIN_URL=admin/

# Comma-separated. Add the server's LAN IP so other branches can connect,
# e.g. localhost,127.0.0.1,192.168.1.50. On Railway the app's own domain
# (RAILWAY_PUBLIC_DOMAIN) is added automatically; list only extra/custom domains.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver

# Extra HTTPS origins allowed to POST forms (custom domains). The Railway domain
# is added automatically. Comma-separated, scheme included.
DJANGO_CSRF_TRUSTED=

# Use a dedicated app user, not root. Create it once with:
#   CREATE USER 'gerlyn_app'@'localhost' IDENTIFIED BY 'your-password';
#   GRANT ALL PRIVILEGES ON `gerlyn_db`.*      TO 'gerlyn_app'@'localhost';
#   GRANT ALL PRIVILEGES ON `test_gerlyn_db`.* TO 'gerlyn_app'@'localhost';
DB_NAME=gerlyn_db
DB_USER=gerlyn_app
DB_PASSWORD=your-app-db-password
DB_HOST=localhost
DB_PORT=3306

# Origins allowed to call the API (the React dev server).
DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email delivery ---------------------------------------------------------
# Local development is safe by default: messages print in the runserver
# terminal and no external SMTP service is contacted.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# In production, change EMAIL_BACKEND to:
# django.core.mail.backends.smtp.EmailBackend
# Then configure the provider below. Gmail on port 587 uses TLS=True and
# SSL=False. Port 465 uses TLS=False and SSL=True. Never enable both.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# Gmail requires the full account address and an App Password (not the normal
# account password). Other providers may use different SMTP credentials.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Must be the authenticated address or an alias authorized by the provider.
# Leave blank to use EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=

# Required in production so links use the public HTTPS origin rather than an
# internal proxy hostname. No trailing slash. Leave blank locally to use the
# host and scheme of the current request.
PUBLIC_BASE_URL=

# --- Media storage (product images, GCash payment proofs) ------------------
# Leave these BLANK for local development: uploads stay on disk under
# MEDIA_ROOT and are served by the /media/ route. No account needed.
#
# In PRODUCTION, set all three (free account at https://cloudinary.com) and
# uploads go to Cloudinary's CDN instead â€” this survives redeploys on hosts
# with an ephemeral filesystem (Railway/Render). Find these three values on
# your Cloudinary dashboard. Setting CLOUDINARY_CLOUD_NAME is what switches
# storage over (see USE_CLOUDINARY in settings.py).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Cache backend -----------------------------------------------------------
# Leave BLANK to use DatabaseCache (the default â€” see CACHES in settings.py).
# Set this to move the cache to Redis instead (add Railway's Redis plugin,
# then paste its connection URL here / into the service's Variables tab).
REDIS_URL=

# --- Error tracking ----------------------------------------------------------
# Leave BLANK to disable (the default â€” see settings.py). Set this to a
# Sentry DSN (free tier at https://sentry.io) to get production error
# reports instead of only what's in Railway's log stream.
SENTRY_DSN=

# --- Audit log ---------------------------------------------------------------
# Change capture is on by default. AUDIT_DB_TRIGGERS makes MySQL itself refuse
# edits/deletes on the audit table (needs the TRIGGER privilege; if the app's
# database user lacks it, `migrate` warns and the app-level protection remains).
AUDIT_ENABLED=True
AUDIT_DB_TRIGGERS=True

# --- Backups -------------------------------------------------------------------
# Off-site, encrypted backups to Backblaze B2 (docs/backup-and-restore.md).
# Leave blank locally; set them on the Railway web service. To try backups
# without Backblaze, BACKUP_STORAGE=local writes to ./tmp_backups.
BACKUP_STORAGE=
B2_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
BACKUP_ENCRYPTION_KEY=
# Optional. The web service runs the daily backup itself (BACKUP_SCHEDULER=False turns
# that off; BACKUP_SCHEDULE_HOUR_UTC=19 is 03:00 Manila). Only set the token below if you
# want an external cron to start backups over HTTP instead.
BACKUP_TRIGGER_TOKEN=
# Only if mysqldump / mysql are not on PATH (e.g. Windows):
BACKUP_MYSQLDUMP=
BACKUP_MYSQL=

# Overdue purchase-order deliveries: days past the delivery date before the
# buyer and supplier are notified, and before the Owner is escalated to.
PO_OVERDUE_GRACE_DAYS=1
PO_OVERDUE_ESCALATE_DAYS=3

# --- Address geocoding and map tiles ----------------------------------------
# Leave the URLs BLANK to use OpenStreetMap's public Nominatim + map tiles (the
# built-in default; works with no account). Set them only to switch to another
# Nominatim-compatible provider. OSM's usage policy requires a real contact in
# GEOCODING_USER_AGENT -- put your own email there.
GEOCODING_SEARCH_URL=
GEOCODING_REVERSE_URL=
GEOCODING_API_KEY=
GEOCODING_API_KEY_PARAM=key
GEOCODING_USER_AGENT=GerlynPLUS/1.0 (address picker; contact: your-email@example.com)
GEOCODING_COUNTRY_CODE=ph
GEOCODING_TIMEOUT=6
GEOCODING_CACHE_SECONDS=86400
GEOCODING_NEGATIVE_CACHE_SECONDS=900
GEOCODING_CLIENT_MAX_REQUESTS=30
GEOCODING_CLIENT_WINDOW_SECONDS=60
GEOCODING_PROVIDER_MIN_INTERVAL_SECONDS=1

# Optional raster tile template. Supported placeholders: {z}, {x}, {y}, and
# {api_key}. Tiles are fetched and cached server-side, keeping the key private.
MAP_TILE_URL_TEMPLATE=
MAP_TILE_API_KEY=
MAP_TILE_ATTRIBUTION=
MAP_TILE_CACHE_SECONDS=604800

# Optional automatic-fulfillment fallback. Use an active Branch database ID.
# When blank, service-area matches are tried first, then the lowest active ID.
DEFAULT_FULFILLMENT_BRANCH_ID=
