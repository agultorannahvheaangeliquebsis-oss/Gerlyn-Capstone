# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# .env is git-ignored — never commit real credentials.

# Generate a new one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me

# Must be False for anything other than local development.
DJANGO_DEBUG=True

# Comma-separated. Add the server's LAN IP so other branches can connect,
# e.g. localhost,127.0.0.1,192.168.1.50
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver

DB_NAME=gerlyn_db
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=localhost
DB_PORT=3306
